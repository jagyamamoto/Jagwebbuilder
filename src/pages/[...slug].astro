---
// content/pages/ のノート1枚が、サイトの1ページになる。
// index.md がトップページ。それ以外は /<slug>/ 。
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { publishedPosts, fmtDate } from '../lib/posts.mjs';
import { site, labels } from '../lib/site.mjs';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((p) => p.data.publish !== false)
    .map((p) => ({ params: { slug: p.id === 'index' ? undefined : p.id }, props: { page: p } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const isHome = page.id === 'index';
const title = d.title || (isHome ? site().name : page.id);
const posts = d.show_blog ? (await publishedPosts()).slice(0, d.show_blog) : [];
const s = site();
const L = labels();

const jsonld = isHome
  ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: s.name, ...(s.url ? { url: s.url } : {}) }]
  : [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: s.name, item: (s.url || '') + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: (s.url || '') + Astro.url.pathname },
    ] }];
---
<Base title={title} description={d.description} jsonld={jsonld}>
  {d.hero && (
    <section class="hero" slot="hero">
      <div class="wrap"><div class="inner">
        <h1>{d.hero}</h1>
        {d.lead && <p>{d.lead}</p>}
        {d.cta_label && d.cta_link && <a class="btn" href={d.cta_link}>{d.cta_label}</a>}
      </div></div>
    </section>
  )}
  <article class="prose">
    {!d.hero && <h1>{title}</h1>}
    <Content />
    {posts.length > 0 && (
      <>
        <h2>{L.blog_home_title}</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li><a href={`/blog/${p.entry.id}/`}>
              <time datetime={p.date?.toISOString().slice(0, 10)}>{fmtDate(p.date)}</time>
              <span class="t">{p.title}</span>
            </a></li>
          ))}
        </ul>
        <p style="margin-top:18px"><a href="/blog/">{L.blog_more}</a></p>
      </>
    )}
  </article>
</Base>
