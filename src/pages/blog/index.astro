---
import Base from '../../layouts/Base.astro';
import { publishedPosts, fmtDate } from '../../lib/posts.mjs';
import { labels } from '../../lib/site.mjs';
const posts = await publishedPosts();
const L = labels();
---
<Base title={L.blog_title} description={L.blog_description}>
  <div class="prose">
    <h1>{L.blog_title}</h1>
    {posts.length === 0 && <p>{L.blog_empty}</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li><a href={`/blog/${p.entry.id}/`}>
          <time datetime={p.date?.toISOString().slice(0, 10)}>{fmtDate(p.date)}</time>
          <span class="t">{p.title}
            {p.entry.data.description && <span class="d">{p.entry.data.description}</span>}
          </span>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
